# Copy to deploy/trial.env on the server and replace every placeholder.
# Do not commit deploy/trial.env.

TRIAL_HOSTNAME=annotate.example.com
APP_BASE_URL=https://annotate.example.com

POSTGRES_USER=sapen_annotate
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=sapen_annotate

# Trial MinIO credentials. MinIO is private on the Docker network by default.
# Use long random values; keep S3 access/secret keys free of double quotes and
# backslashes because the one-shot minio-init container writes a temporary JSON config.
S3_ACCESS_KEY=replace-with-long-random-access-key
S3_SECRET_KEY=replace-with-long-random-secret-key
S3_BUCKET=sapen-annotate-trial
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# App-side upload limits in bytes. Caddy should be set above these values.
# Next's proxy body limit must also stay above mask/image upload limits.
# Supported customer-trial image uploads are PNG/JPEG only.
IMAGE_UPLOAD_MAX_BYTES=104857600
MASK_UPLOAD_MAX_BYTES=52428800
PREDICTION_BATCH_UPLOAD_MAX_BYTES=104857600
NEXT_PROXY_CLIENT_MAX_BODY_SIZE=120mb
PREDICTION_BATCH_MAX_ITEMS=200
PREDICTION_BATCH_PROCESS_LIMIT=25
PREDICTION_BATCH_ITEM_MAX_ATTEMPTS=3
PREDICTION_BATCH_LEASE_SECONDS=900
PREDICTION_BATCH_MAX_JOBS_PER_TICK=5
PREDICTION_BATCH_WORKER_INTERVAL_SECONDS=30
PREDICTION_IMPORT_PROCESSOR_ID=sapen-annotate-worker
EXPORT_JOB_LEASE_SECONDS=900
EXPORT_JOB_MAX_ATTEMPTS=3
EXPORT_JOB_RETRY_DELAY_SECONDS=60
EXPORT_JOB_MAX_JOBS_PER_TICK=2
EXPORT_JOB_WORKER_INTERVAL_SECONDS=30
EXPORT_JOB_PROCESSOR_ID=sapen-annotate-export-worker
BATCH_STAGING_COMPLETED_RETENTION_DAYS=7
BATCH_STAGING_FAILED_RETENTION_DAYS=14
PRESIGNED_UPLOAD_STAGING_RETENTION_HOURS=24
STORAGE_CLEANUP_MAX_DELETE_PER_RUN=500
SLICE_CROP_DEFAULT_PADDING_PX=32
CADDY_MAX_BODY_SIZE=120MB

# DB-backed high-cost write limits. These are single-host trial guards, not a
# billing/quota system. Editor save limits are intentionally higher than export
# and prediction-import limits.
HIGH_COST_LIMITS_ENABLED=true
HIGH_COST_UPLOAD_MAX_REQUESTS=20
HIGH_COST_UPLOAD_WINDOW_SECONDS=60
HIGH_COST_EDITOR_SAVE_MAX_REQUESTS=120
HIGH_COST_EDITOR_SAVE_WINDOW_SECONDS=60
HIGH_COST_EXPORT_CREATE_MAX_REQUESTS=5
HIGH_COST_EXPORT_CREATE_WINDOW_SECONDS=600
HIGH_COST_PREDICTION_IMPORT_MAX_REQUESTS=10
HIGH_COST_PREDICTION_IMPORT_WINDOW_SECONDS=600
HIGH_COST_OPERATIONS_MAX_REQUESTS=10
HIGH_COST_OPERATIONS_WINDOW_SECONDS=600

# Trial export caps. RB-112 uses async jobs, but package generation still uses
# JSZip behind these caps rather than a streaming writer.
TRAINING_EXPORT_MAX_ITEMS=500
TRAINING_EXPORT_MAX_BYTES=536870912
PREDICTION_ANALYSIS_EXPORT_MAX_ITEMS=500
PREDICTION_ANALYSIS_EXPORT_MAX_BYTES=536870912

# Optional prediction-import/export worker account. Use a named OWNER/QA account
# if the worker profile is enabled; leave empty if processing jobs manually.
# Prefer SAPEN_JOB_PASSWORD_FILE when deployment tooling can mount secrets.
SAPEN_JOB_EMAIL=
SAPEN_JOB_PASSWORD_FILE=
SAPEN_JOB_PASSWORD=

# Optional storage cleanup account. Use a named ADMIN account and dry-run first.
# Prefer SAPEN_CLEANUP_PASSWORD_FILE when deployment tooling can mount secrets.
SAPEN_CLEANUP_EMAIL=
SAPEN_CLEANUP_PASSWORD_FILE=
SAPEN_CLEANUP_PASSWORD=

# Optional trial user management and operator attribution variables for
# trial:bootstrap, trial:user:create, and trial:user:deactivate commands.
SAPEN_TRIAL_USER_PASSWORD_FILE=
SAPEN_TRIAL_USER_PASSWORD=
SAPEN_OPERATOR_EMAIL=
SAPEN_REQUIRE_OPERATOR_ATTRIBUTION=true

# Auth/session hardening. Keep shared demo credentials hidden for customer trials.
SHOW_DEMO_CREDENTIALS=false
LOGIN_RATE_LIMIT_MAX_FAILURES=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_LOCK_SECONDS=900
SESSION_LAST_SEEN_UPDATE_INTERVAL_SECONDS=900
