# SaPen Annotate local development placeholders.
# Copy to .env and .env.local as needed; do not commit real secrets.

# Prisma / PostgreSQL
DATABASE_URL="postgresql://sapen_annotate_user:sapen_annotate_password@localhost:55432/sapen_annotate?schema=public"
POSTGRES_USER="sapen_annotate_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="sapen_annotate"
POSTGRES_PORT="55432"

# MinIO / S3-compatible object storage
MINIO_ROOT_USER="minio-admin"
MINIO_ROOT_PASSWORD="change-me"
MINIO_API_PORT="59000"
MINIO_CONSOLE_PORT="59001"
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY="minio-admin"
S3_SECRET_KEY="change-me"
S3_BUCKET="sapen-annotate-local"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"
