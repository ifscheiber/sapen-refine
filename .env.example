# SaPen Annotate local development placeholders.
# Copy to .env and .env.local as needed; do not commit real secrets.

# Application origin
APP_BASE_URL="http://localhost:3000"

# Prisma / PostgreSQL
DATABASE_URL="postgresql://sapen_annotate_user:sapen_annotate_password@localhost:55432/sapen_annotate?schema=public"
POSTGRES_USER="sapen_annotate_user"
POSTGRES_PASSWORD="change-me"
POSTGRES_DB="sapen_annotate"
POSTGRES_PORT="55432"

# MinIO / S3-compatible object storage
MINIO_ROOT_USER="minio-admin"
MINIO_ROOT_PASSWORD="change-me"
MINIO_API_PORT="59000"
MINIO_CONSOLE_PORT="59001"
S3_ENDPOINT="http://localhost:59000"
S3_ACCESS_KEY="minio-admin"
S3_SECRET_KEY="change-me"
S3_BUCKET="sapen-annotate-local"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# Upload limits in bytes. Local defaults allow large PNG/JPEG camera images while
# keeping a clear server-side cap. Trial Caddy limits should be set above these values.
# Supported image upload content types are fixed in code to image/png and image/jpeg.
IMAGE_UPLOAD_MAX_BYTES="104857600"
MASK_UPLOAD_MAX_BYTES="52428800"
PREDICTION_BATCH_UPLOAD_MAX_BYTES="104857600"
PREDICTION_BATCH_MAX_ITEMS="200"
PREDICTION_BATCH_PROCESS_LIMIT="25"
PREDICTION_BATCH_ITEM_MAX_ATTEMPTS="3"
PREDICTION_BATCH_LEASE_SECONDS="900"
PREDICTION_BATCH_MAX_JOBS_PER_TICK="5"
PREDICTION_BATCH_WORKER_INTERVAL_SECONDS="30"
PREDICTION_IMPORT_PROCESSOR_ID="sapen-annotate-worker"
BATCH_STAGING_COMPLETED_RETENTION_DAYS="7"
BATCH_STAGING_FAILED_RETENTION_DAYS="14"
PRESIGNED_UPLOAD_STAGING_RETENTION_HOURS="24"
STORAGE_CLEANUP_MAX_DELETE_PER_RUN="500"

# Optional API-based prediction-import worker credentials. Use a named OWNER/QA
# trial account; do not use shared demo credentials for customer-facing trials.
SAPEN_JOB_BASE_URL="http://localhost:3000"
SAPEN_JOB_EMAIL=""
SAPEN_JOB_PASSWORD=""

# Optional API-based storage cleanup credentials. Use a named ADMIN account.
SAPEN_CLEANUP_BASE_URL="http://localhost:3000"
SAPEN_CLEANUP_EMAIL=""
SAPEN_CLEANUP_PASSWORD=""

# Auth/session hardening
# Demo credentials are still shown automatically in NODE_ENV=development.
SHOW_DEMO_CREDENTIALS="false"
LOGIN_RATE_LIMIT_MAX_FAILURES="5"
LOGIN_RATE_LIMIT_WINDOW_SECONDS="900"
LOGIN_RATE_LIMIT_LOCK_SECONDS="900"
SESSION_LAST_SEEN_UPDATE_INTERVAL_SECONDS="900"
