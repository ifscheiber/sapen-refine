{
  "name": "sapen-annotate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:bootstrap": "prisma migrate deploy && prisma db seed",
    "db:rebuild": "docker compose down -v && docker compose up -d --wait postgres minio && docker compose up -d minio-init && prisma migrate deploy && prisma db seed",
    "trial:bootstrap": "node scripts/trial-bootstrap.mjs",
    "trial:user:create": "node scripts/create-trial-user.mjs",
    "trial:user:deactivate": "node scripts/deactivate-trial-user.mjs",
    "handoff:archive": "node scripts/create-handoff-archive.mjs",
    "handoff:validate": "node scripts/validate-handoff-archive.mjs",
    "jobs:prediction-import": "node scripts/process-prediction-import-batch.mjs",
    "exports:process": "node scripts/process-export-jobs.mjs",
    "storage:cleanup": "node scripts/storage-cleanup.mjs",
    "dataset:materialize": "node scripts/materialize-sapen-cnn-dataset.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "seed": "prisma db seed",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ipad-prep": "playwright test tests/e2e/ipad-viewport-prep.spec.ts",
    "check:docs-links": "vitest run tests/unit/docs-link-governance.test.ts",
    "check:decomposition-hotspots": "node scripts/report-decomposition-hotspots.mjs",
    "check:design-hardcoding": "rg -n --glob 'src/**' --glob '!src/design/**' --glob '!src/mask/labels.ts' '#[0-9a-fA-F]{3,8}|rgba\\(|oklch\\(|(^|:)(bg|text|border)-(slate|gray|zinc|neutral|stone|red|orange|amber|yellow|lime|green|emerald|teal|cyan|sky|blue|indigo|violet|purple|fuchsia|pink|rose|black|white)' && exit 1 || exit 0",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "overrides": {
    "@hono/node-server": "1.19.14",
    "postcss": "^8.5.14"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.974.0",
    "@aws-sdk/s3-request-presigner": "^3.974.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.6",
    "pg": "^8.17.2",
    "prisma": "^7.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  }
}
